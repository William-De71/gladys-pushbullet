{
  "_comment": "Keys users store, as published in 0.1.0. Never edit without a documented migration (see test/structure.test.js).",
  "type": "communication",
  "messaging": {
    "receive": false
  },
  "config_schema": [
    {
      "key": "access_token",
      "type": "secret"
    },
    {
      "key": "title",
      "type": "string"
    },
    {
      "key": "language",
      "type": "select"
    },
    {
      "key": "create_device",
      "type": "boolean"
    },
    {
      "key": "device_name",
      "type": "string"
    },
    {
      "key": "receive_pushes",
      "type": "boolean"
    },
    {
      "key": "receive_mirrors",
      "type": "boolean"
    },
    {
      "key": "encryption_password",
      "type": "secret"
    }
  ],
  "contact_schema": [
    {
      "key": "email",
      "type": "string"
    },
    {
      "key": "device",
      "type": "string"
    }
  ],
  "languages": ["en", "fr", "de", "es"],
  "actions": ["test_connection", "send_test_push"],
  "scene_triggers": [
    {
      "key": "push_received",
      "fields": [
        {
          "key": "target",
          "type": "multi_select",
          "options": ["gladys", "all", "other_device"]
        },
        {
          "key": "origin",
          "type": "multi_select",
          "options": ["self", "person", "channel"]
        },
        {
          "key": "keyword",
          "type": "string",
          "options": []
        },
        {
          "key": "sender_email",
          "type": "string",
          "options": []
        },
        {
          "key": "type",
          "type": "multi_select",
          "options": ["note", "link", "file"]
        }
      ],
      "variables": [
        {
          "key": "title",
          "type": "string"
        },
        {
          "key": "body",
          "type": "string"
        },
        {
          "key": "url",
          "type": "string"
        },
        {
          "key": "file_name",
          "type": "string"
        },
        {
          "key": "keyword",
          "type": "string"
        },
        {
          "key": "type",
          "type": "string"
        },
        {
          "key": "origin",
          "type": "string"
        },
        {
          "key": "target",
          "type": "string"
        },
        {
          "key": "sender_name",
          "type": "string"
        },
        {
          "key": "sender_email",
          "type": "string"
        },
        {
          "key": "source_device",
          "type": "string"
        },
        {
          "key": "received_at",
          "type": "string"
        }
      ]
    },
    {
      "key": "notification_mirrored",
      "fields": [
        {
          "key": "application_name",
          "type": "string",
          "options": []
        },
        {
          "key": "source_device",
          "type": "string",
          "options": []
        },
        {
          "key": "keyword",
          "type": "string",
          "options": []
        }
      ],
      "variables": [
        {
          "key": "application_name",
          "type": "string"
        },
        {
          "key": "package_name",
          "type": "string"
        },
        {
          "key": "title",
          "type": "string"
        },
        {
          "key": "body",
          "type": "string"
        },
        {
          "key": "keyword",
          "type": "string"
        },
        {
          "key": "source_device",
          "type": "string"
        },
        {
          "key": "received_at",
          "type": "string"
        }
      ]
    },
    {
      "key": "push_not_sent",
      "fields": [
        {
          "key": "reason",
          "type": "multi_select",
          "options": [
            "quota_exceeded",
            "invalid_token",
            "not_configured",
            "invalid_target",
            "not_found",
            "rejected",
            "rate_limited",
            "server_error",
            "timeout",
            "unreachable",
            "unexpected"
          ]
        }
      ],
      "variables": [
        {
          "key": "reason",
          "type": "string"
        },
        {
          "key": "status",
          "type": "number"
        },
        {
          "key": "error",
          "type": "string"
        },
        {
          "key": "target",
          "type": "string"
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "send_push",
      "fields": ["title", "message", "url", "device", "email", "channel_tag"],
      "outputs": [
        {
          "key": "push_iden",
          "type": "string"
        },
        {
          "key": "target",
          "type": "string"
        }
      ]
    },
    {
      "key": "send_sms",
      "fields": ["phone_numbers", "message", "device"],
      "outputs": [
        {
          "key": "text_iden",
          "type": "string"
        },
        {
          "key": "device",
          "type": "string"
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "account",
      "settings": []
    },
    {
      "key": "recent",
      "settings": []
    }
  ]
}
